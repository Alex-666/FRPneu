  html += '      <div class="modal-footer">';
  html += '        <a href="http://images.ocdevwizard.com/{{ _name }}/'+$(element).attr('data-faq-target')+'.gif" class="btn btn-info" target="_blank">{{ button_open_image_in_original_size }}</a>';
  html += '      </div>';
  html += '    </div';
  html += '  </div>';
  html += '</div>';

  $('body').append(html);

  $('#modal-faq').modal('show');
});

