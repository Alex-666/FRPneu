<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right" id="top-nav-line">
        <button type="submit" formaction="{{ action }}" form="form" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <button type="submit" formaction="{{ action_plus }}" form="form" data-toggle="tooltip" title="{{ button_save_and_stay }}" class="btn btn-primary"><i class="fa fa-save"></i> + <i class="fa fa-refresh"></i></button>
        <div class="btn-group">
          <button type="button" class="btn btn-danger dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="fa fa-trash"></i>&nbsp;&nbsp;&nbsp;<span class="caret"></span></button>
          <ul class="dropdown-menu dropdown-menu-right">
            <li><a onclick="confirm('{{ text_are_you_sure }}') ? href='{{ uninstall }}' : false;"><i class="fa fa-trash"></i> {{ button_uninstall }}</a></li>
            <li><a onclick="confirm('{{ text_are_you_sure }}') ? href='{{ uninstall_and_remove }}' : false;"><i class="fa fa-trash"></i> {{ button_uninstall_and_remove }}</a></li>
            <li><a onclick="confirm('{{ text_are_you_sure }}') ? href='{{ cache }}' : false;"><i class="fa fa-trash"></i> {{ button_cache }}</a></li>
            <li><a onclick="confirm('{{ text_are_you_sure }}') ? href='{{ cache_backup }}' : false;"><i class="fa fa-trash"></i> {{ button_cache_backup }}</a></li>
            <li><a onclick="confirm('{{ text_are_you_sure }}') ? href='{{ restore }}' : false;"><i class="fa fa-repeat"></i> {{ button_restore }}</a></li>
          </ul>
        </div>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb-module">
        {% for breadcrumb in breadcrumbs %}
          {% if (breadcrumb['href']) %}
            <li><a href="{{ breadcrumb['href'] }}">{{ breadcrumb['text'] }}</a></li>
          {% elseif (breadcrumb['href'] is empty and breadcrumb['dropdown']) %}
            <li>
              <div class="btn-group dropdown-on-hover">
                <button type="button" class="btn btn-default dropdown-toggle btn-xs" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{ breadcrumb['text'] }} <span class="caret"></span></button>
                {% if (breadcrumb['dropdown']) %}
                  <ul class="dropdown-menu">
                    {% for dropdown in breadcrumb['dropdown'] %}
                      <li><a href="{{ dropdown['href'] }}">{% if (dropdown['active']) %}<i class="fa fa-check-square-o"></i>{% else %}<i class="fa fa-square-o"></i>{% endif %} {{ dropdown['text'] }}</a></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            </li>
          {% else %}
            <li><a>{{ breadcrumb['text'] }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid" id="top-alerts">
    {% if (error_warning) %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if (warning) %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if (success) %}
    <div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="row">
      <div class="col-sm-3 col-md-3 col-lg-2">
        <div class="btn-group" style="width: 100%;margin-bottom: 10px;">
          <button type="button" class="btn btn-default dropdown-toggle btn-block" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="fa fa-cog"></i> {{ text_select_store }} <span class="caret"></span></button>
          <ul class="dropdown-menu">
            {% for store in all_stores %}
              <li><a href="{{ store['href'] }}">{% if (store_id == store['store_id']) %}<i class="fa fa-check-square-o"></i>{% else %}<i class="fa fa-square-o"></i>{% endif %} {{ store['name'] }}</a></li>
            {% endfor %}
          </ul>
        </div>
        <!-- Nav tabs -->
        <div class="list-group list-group-root well" id="setting-tabs">
          <a class="list-group-item list-group-item-info"><i class="fa fa-cog"></i>{{ tab_control_panel }}</a>
          <div class="list-group">
            <a class="list-group-item" data-toggle="tab" href="#general-block" role="tab"><i class="fa fa-cogs"></i> {{ tab_general_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#basic-block" role="tab"><i class="fa fa-cogs"></i> {{ tab_basic_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#product-widget-block" role="tab"><i class="fa fa-cogs"></i> {{ tab_product_widget_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#cart-widget-block" role="tab"><i class="fa fa-cogs"></i> {{ tab_cart_widget_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#popup-widget-block" role="tab"><i class="fa fa-cogs"></i> {{ tab_popup_widget_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#static-widget-block" role="tab"><i class="fa fa-cogs"></i> {{ tab_static_widget_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#layout-block" role="tab"><i class="fa fa-eye"></i> {{ tab_layout_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#css-block" role="tab"><i class="fa fa-css3"></i> {{ tab_css_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#popup-block" role="tab"><i class="fa fa-desktop"></i> {{ tab_popup_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#module-import-export-block" role="tab"><i class="fa fa-file-archive-o"></i> {{ tab_module_import_export_setting }}</a>
          </div>
          <a class="list-group-item list-group-item-info"><i class="fa fa-language"></i>{{ tab_language_setting }}</a>
          <div class="list-group">
            <a class="list-group-item" data-toggle="tab" href="#language-product-widget-block" role="tab"><i class="fa fa-flag-o"></i> {{ tab_product_widget_language_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#language-cart-widget-block" role="tab"><i class="fa fa-flag-o"></i> {{ tab_cart_widget_language_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#language-popup-widget-block" role="tab"><i class="fa fa-flag-o"></i> {{ tab_popup_widget_language_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#language-static-widget-block" role="tab"><i class="fa fa-flag-o"></i> {{ tab_static_widget_language_setting }}</a>
          </div>
          <a class="list-group-item list-group-item-info"><i class="fa fa-thumbs-o-up"></i>{{ tab_marketing_tools_setting }}</a>
          <div class="list-group">
            <a class="list-group-item" data-toggle="tab" href="#up-sell-block" role="tab"><i class="fa fa-sliders"></i> {{ tab_up_sell_products_setting }}</a>
          </div>
          <a class="list-group-item list-group-item-info"><i class="fa fa-life-ring"></i>{{ tab_support_setting }}</a>
          <div class="list-group">
            <a class="list-group-item" data-toggle="tab" href="#support-extension-block" role="tab"><i class="fa fa-info-circle"></i> {{ tab_support_extension_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#support-general-block" role="tab"><i class="fa fa-info-circle"></i> {{ tab_support_general_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#support-terms-block" role="tab"><i class="fa fa-info-circle"></i> {{ tab_support_terms_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#support-faq-block" role="tab"><i class="fa fa-question-circle"></i> {{ tab_support_faq_setting }}</a>
            <a class="list-group-item" data-toggle="tab" href="#promo-block" role="tab"><i class="fa fa-briefcase"></i> {{ tab_promo_setting }}</a>
          </div>
        </div>
      </div>
      <div class="col-sm-9 col-md-9 col-lg-10">
        <div class="panel panel-default">
          <div class="panel-body">
            <form method="post" enctype="multipart/form-data" id="form" class="form-horizontal">
              <div class="tab-content">
                <!-- TAB General block -->
                <div class="tab-pane fade active in" role="tabpanel" id="general-block">
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ text_activate_module }}</label>
                    <div class="col-sm-10">
                      <div class="btn-group btn-toggle" data-toggle="buttons">
                        <label class="btn {{ form_data['activate'] == 1 ? 'active btn-success' : 'btn-default' }}">
                          <input type="radio"
                            name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[activate]"
                            value="1"
                            autocomplete="off"
                            {{ form_data['activate'] == 1 ? 'checked="checked"' : '' }}
                          />{{ text_yes }}
                        </label>
                        <label class="btn {{ form_data['activate'] == 0 ? 'active btn-success' : 'btn-default' }}">
                          <input type="radio"
                            name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[activate]"
                            value="0"
                            autocomplete="off"
                            {{ form_data['activate'] == 0 ? 'checked="checked"' : '' }}
                          />{{ text_no }}
                        </label>
                      </div>
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-main_product_id_selector">{{ text_main_product_id_selector }}</label>
                    <div class="col-sm-10">
                      <div class="input-group">
                        <span class="input-group-addon">{{ text_css_id_indicator }}</span>
                        <input value="{{ form_data['main_product_id_selector'] }}" type="text" name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[main_product_id_selector]" class="form-control" id="input-main_product_id_selector" />
                        <span class="input-group-btn">
                          <button class="btn btn-default" type="button" data-faq-target="faq_3" data-toggle="tooltip" title="{{ text_open_example }}"><i class="fa fa-info-circle"></i></button>
                        </span>
                      </div>
                      {% if (error_main_product_id_selector) %}
                        <div class="alert alert-danger text-danger"><i class="fa fa-exclamation-circle"></i> {{ error_main_product_id_selector }}</div>
                      {% endif %}
                      <div class="alert alert-info" role="alert"><i class="fa fa-info-circle"></i> {{ text_main_product_id_selector_faq }}</div>
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-route_to_system_add_method">{{ text_route_to_system_add_method }}</label>
                    <div class="col-sm-10">
                      <div class="input-group">
                        <span class="input-group-addon">{{ text_route_indicator }}</span>
                        <input value="{{ form_data['route_to_system_add_method'] }}" type="text" name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[route_to_system_add_method]" class="form-control" id="input-route_to_system_add_method" />
                        <span class="input-group-btn">
                          <button class="btn btn-default" type="button" data-faq-target="faq_4" data-toggle="tooltip" title="{{ text_open_example }}"><i class="fa fa-info-circle"></i></button>
                        </span>
                      </div>
                      {% if (error_route_to_system_add_method) %}
                        <div class="alert alert-danger text-danger"><i class="fa fa-exclamation-circle"></i> {{ error_route_to_system_add_method }}</div>
                      {% endif %}
                      <div class="alert alert-info" role="alert"><i class="fa fa-info-circle"></i> {{ text_route_to_system_add_method_faq }}</div>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ text_customer_groups }}</label>
                    <div class="col-sm-10">
                      {% set row_height = 55 %} {% set row = 0 %} {% for customer_group in all_customer_groups %}
                      {% if (row < 5) %} {% set row_height = row_height*1.26 %} {% endif %} {% set row = row + 1 %}
                      {% endfor %}
                      <div class="well well-sm" style="height: {{ row_height }}px; overflow: auto;">
                        {% set row = 0 %} {% for customer_group in all_customer_groups %}
                        <div class="checkbox">
                          <label>
                            <input
                              type="checkbox"
                              name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[customer_groups][]"
                              value="{{ customer_group['customer_group_id'] }}" {{ form_data['customer_groups'] is not empty and customer_group['customer_group_id'] in form_data['customer_groups'] ? 'checked' : '' }}
                            /> {{ customer_group['name'] }}
                          </label>
                        </div>
                        {% set row = row + 1 %}
                        {% endfor %}
                      </div>
                      <div class="btn-group">
                        <button type="button" class="btn btn-default btn-xs" onclick="$(this).parent().parent().find(':checkbox').trigger('click').attr('checked', true);">{{ text_select_all }}</button>
                        <button type="button" class="btn btn-default btn-xs" onclick="$(this).parent().parent().find(':checkbox').attr('checked', false);">{{ text_unselect_all }}</button>
                      </div>
                      <div class="alert alert-info" role="alert"><i class="fa fa-info-circle"></i> {{ text_customer_groups_faq }}</div>
                    </div>
                  </div>
                </div>
                <!-- TAB Basic block -->
                <div class="tab-pane fade" role="tabpanel" id="basic-block">
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ text_direction_type }}</label>
                    <div class="col-sm-10">
                      {% for language in languages %}
                      <div class="btn-group-vertical btn-toggle" data-toggle="buttons">
                        <label class="btn {{ form_data['direction_type'][language['language_id']] is defined and form_data['direction_type'][language['language_id']] == 1 ? 'active btn-success' : 'btn-default' }}">
                          <input type="radio"
                            name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[direction_type][{{ language['language_id'] }}]"
                            value="1"
                            autocomplete="off"
                            {{ form_data['direction_type'][language['language_id']] is defined and form_data['direction_type'][language['language_id']] == 1 ? 'checked="checked"' : '' }}
                          /><img src="{{ language['image'] }}" title="{{ language['name'] }}" /> {{ text_direction_type_1 }}
                        </label>
                        <label class="btn {{ form_data['direction_type'][language['language_id']] is defined and form_data['direction_type'][language['language_id']] == 2 ? 'active btn-success' : 'btn-default' }}">
                          <input type="radio"
                            name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[direction_type][{{ language['language_id'] }}]"
                            value="2"
                            autocomplete="off"
                            {{ form_data['direction_type'][language['language_id']] is defined and form_data['direction_type'][language['language_id']] == 2 ? 'checked="checked"' : '' }}
                          /><img src="{{ language['image'] }}" title="{{ language['name'] }}" /> {{ text_direction_type_2 }}
                        </label>
                      </div>
                      {% endfor %}
                    </div>
                  </div>
                  <div class="form-group pro-block">
                    <label class="col-sm-2 control-label">{{ text_minify_main_js }}</label>
                    <div class="col-sm-10">
                      <select name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[minify_main_js]" class="form-control">
                        <option value="0" {{ form_data['minify_main_js'] == 0 ? 'selected="selected"' : '' }} >{{ text_no }}</option>
                        <option value="1" {{ form_data['minify_main_js'] == 1 ? 'selected="selected"' : '' }} >{{ text_minify_main_js_1 }}</option>
                        <option value="2" {{ form_data['minify_main_js'] == 2 ? 'selected="selected"' : '' }} >{{ text_minify_main_js_2 }}</option>
                      </select>
                    </div>
                  </div>
                </div>
                <!-- TAB Product widget block -->
                <div class="tab-pane fade" role="tabpanel" id="product-widget-block">
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ text_activate_product_widget }}</label>
                    <div class="col-sm-10">
                      <div class="btn-group" data-toggle="buttons">
                        <label class="btn btn-success {{ form_data['activate_product_widget'] == 1 ? 'active' : '' }}">
                          <input type="radio"
                            name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[activate_product_widget]"
                            value="1"
                            autocomplete="off"
                            {{ form_data['activate_product_widget'] == 1 ? 'checked="checked"' : '' }}
                          />{{ text_yes }}
                        </label>
                        <label class="btn btn-success {{ form_data['activate_product_widget'] == 0 ? 'active' : '' }}">
                          <input type="radio"
                            name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[activate_product_widget]"
                            value="0"
                            autocomplete="off"
                            {{ form_data['activate_product_widget'] == 0 ? 'checked="checked"' : '' }}
                          />{{ text_no }}
                        </label>
                      </div>
                      <div class="alert alert-warning" role="alert"><i class="fa fa-info-circle" aria-hidden="true"></i> {{ text_activate_product_widget_faq_1 }}</div>
                      <div class="alert alert-info" role="alert"><i class="fa fa-info-circle" aria-hidden="true"></i> {{ text_activate_product_widget_faq_2 }}</div>
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="textarea-insert_widget">{{ text_insert_widget }}</label>
                    <div class="col-sm-10">
                      <div class="input-group">
                        <span class="input-group-addon">{{ text_js_indicator }}</span>
                        <textarea style="min-height:70px;" name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[insert_widget]" class="form-control" id="textarea-insert_widget">{{ form_data['insert_widget'] }}</textarea>
                      </div>
                      {% if (error_insert_widget) %}
                        <div class="alert alert-danger text-danger">{{ error_insert_widget }}</div>
                      {% endif %}
                      <div class="alert alert-info" role="alert"><i class="fa fa-info-circle" aria-hidden="true"></i> {{ text_insert_widget_faq }}</div>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ text_product_widget_show_product_image }}</label>
                    <div class="col-sm-10">
                      <div class="btn-group" data-toggle="buttons">
                        <label class="btn btn-success {{ form_data['product_widget_show_product_image'] == 1 ? 'active' : '' }}">
                          <input type="radio"
                            name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[product_widget_show_product_image]"
                            value="1"
                            autocomplete="off"
                            {{ form_data['product_widget_show_product_image'] == 1 ? 'checked="checked"' : '' }}
                          />{{ text_yes }}
                        </label>
                        <label class="btn btn-success {{ form_data['product_widget_show_product_image'] == 0 ? 'active' : '' }}">
                          <input type="radio"
                            name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[product_widget_show_product_image]"
                            value="0"
                            autocomplete="off"
                            {{ form_data['product_widget_show_product_image'] == 0 ? 'checked="checked"' : '' }}
                          />{{ text_no }}
                        </label>
                      </div>
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label">{{ text_dementions_of_main_image }}</label>
                    <div class="col-sm-10">
                      <div class="input-group">
                        <span class="input-group-addon">{{ text_width_indicator }}</span>
                        <input value="{{ form_data['product_widget_main_image_width'] }}" type="text" name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[product_widget_main_image_width]" class="form-control" placeholder="{{ text_image_width_ph }}" />
                        <span class="input-group-addon">{{ text_px }}</span>
                      </div>
                      <div class="special-margin"></div>
                      <div class="input-group">
                        <span class="input-group-addon">{{ text_height_indicator }}</span>
                        <input value="{{ form_data['product_widget_main_image_height'] }}" type="text" name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[product_widget_main_image_height]" class="form-control" placeholder="{{ text_image_height_ph }}" />
                        <span class="input-group-addon">{{ text_px }}</span>
                      </div>
                      {% if (error_product_widget_main_image_width) %}
                        <div class="alert alert-danger text-danger"><i class="fa fa-exclamation-circle"></i> {{ error_product_widget_main_image_width }}</div>
                      {% endif %}
                      {% if (error_product_widget_main_image_height) %}
                        <div class="alert alert-danger text-danger"><i class="fa fa-exclamation-circle"></i> {{ error_product_widget_main_image_height }}</div>
                      {% endif %}
                      <div class="alert alert-info" role="alert"><i class="fa fa-info-circle"></i> {{ text_warning_dementions_of_main_image }}</div>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ text_product_widget_show_product_price }}</label>
                    <div class="col-sm-10">
                      <div class="btn-group" data-toggle="buttons">
                        <label class="btn btn-success {{ form_data['product_widget_show_product_price'] == 1 ? 'active' : '' }}">
                          <input type="radio"
                            name="r4k4j5k4q4f584a4j5b4t5j416q464p4w5j484p5q544g4w5u5z3a4h4r4i464b464q4j5[product_widget_show_product_price]"
                            value="1"
                            autocomplete="off"
                            {{ form_data['product_widget_show_product_price'] == 1 ? 'checked="checked"' : '' }}
                          />{{ text_yes }}
                        </label>
