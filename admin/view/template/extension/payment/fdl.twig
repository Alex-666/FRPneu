{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-fdl" data-toggle="tooltip" title="{{ text_button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ text_button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
            </div>
            <h1>{{ text_heading_title }}</h1>
            <ul class="breadcrumb">
                <?php foreach ($breadcrumbs as $breadcrumb) { ?>
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                <?php } ?>
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if error_warning %}
        <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        {% if success %}
        <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-fdl" class="form-horizontal">


                    <div class="form-group required">
                        <label class="col-sm-2 control-label" for="fdl_config_server">{{ text_fdl_config_server }}</label>
                        <div class="col-sm-10">
                            <input type="text" name="payment_fdl_config_server" id="fdl_config_server" value="{{ fdl_config_server }}" placeholder="" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group required">
                        <label class="col-sm-2 control-label" for="fdl_config_cert">{{ text_fdl_config_cert }}</label>
                        <div class="col-sm-10">
                            <textarea name="payment_fdl_config_cert" id="fdl_config_cert" cols="100" rows="8">{{ fdl_config_cert }}</textarea>
                        </div>
                    </div>

                    <div class="form-group required">
                        <label class="col-sm-2 control-label" for="fdl_config_certpass">{{ text_fdl_config_certpass }}</label>
                        <div class="col-sm-10">
                            <input type="text" name="payment_fdl_config_certpass" id="fdl_config_certpass" value="{{ fdl_config_certpass }}" placeholder="" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="fdl_sort_order">{{ text_fdl_sort_order }}</label>
                        <div class="col-sm-10">
                            <input type="text" name="payment_fdl_sort_order" id="fdl_sort_order" value="{{ fdl_sort_order }}" placeholder="{{ text_fdl_sort_order }}" class="form-control"/>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="fdl_total">{{ text_fdl_total }}</label>
