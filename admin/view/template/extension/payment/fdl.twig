                            <select name="payment_fdl_refund_status_id" id="input-refund-status" class="form-control">
                                {% for order_status in order_statuses %}
                                {% if order_status.order_status_id == fdl_refund_status_id %}
                                <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                                {% else %}
                                <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                                {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="form-group disabled">
                        <label class="col-sm-2 control-label" for="fdl_confirmation_url">{{ text_confirmation_url }}</label>
                        <div class="col-sm-10">
                            <input type="text" name="payment_fdl_confirmation_url" id="fdl_confirmation_url" value="{{ confirmation_url }}" placeholder="" class="form-control" readonly="true" />
