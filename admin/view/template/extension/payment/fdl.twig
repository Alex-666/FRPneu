                        <div class="col-sm-10">
                            <select name="payment_fdl_status" id="input-status" class="form-control">
                                {% if fdl_status %}
                                <option value="1" selected="selected">{{ text_enabled }}</option>
                                <option value="0">{{ text_disabled }}</option>
                                {% else %}
                                <option value="1">{{ text_enabled }}</option>
                                <option value="0" selected="selected">{{ text_disabled }}</option>
                                {% endif %}
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="input-order-status">{{ text_fdl_order_status_id }}</label>
                        <div class="col-sm-10">
                            <select name="payment_fdl_order_status_id" id="input-order-status" class="form-control">
                                {% for order_status in order_statuses %}
                                {% if order_status.order_status_id == fdl_order_status_id %}
                                <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                                {% else %}
                                <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                                {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="input-refund-status">{{ text_fdl_refund_status_id }}</label>
