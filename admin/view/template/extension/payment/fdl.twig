                        <label class="col-sm-2 control-label" for="order_id">{{ text_fdl_order_id }}</label>
                        <div class="col-sm-10">
                            <input type="text" name="order_id" id="order_id" value="" placeholder="" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="order_id"></label>
                        <div class="col-sm-10">
                            <input type="submit" name="issue_refund" value="{{ text_issue_refund }}" class="btn btn-primary" />
