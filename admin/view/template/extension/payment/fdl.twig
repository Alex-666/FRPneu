                    </div>

                    <div class="form-group required">
                        <label class="col-sm-2 control-label" for="fdl_closeday_token">{{ text_fdl_closeday_token }}</label>
                        <div class="col-sm-10">
                            <input type="text" name="payment_fdl_closeday_token" id="fdl_closeday_token" value="{{ fdl_closeday_token }}" placeholder="" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group disabled">
                        <label class="col-sm-2 control-label" for="fdl_closing_url">{{ text_closing_url }}</label>
                        <div class="col-sm-10">
                            <input type="text" name="payment_fdl_closing_url" id="fdl_closing_url" value="{{ closing_url }}" placeholder="" class="form-control" readonly="true" style="width:80%;float:left;margin-right:6px" />
                            <a href="{{ closing_url }}&return=back" title="{{ text_closeday }}" class="btn btn-primary">{{ text_closeday }}</a>
                        </div>
                    </div>

                </form>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_issue_refund }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ refund }}" method="post" enctype="multipart/form-data" id="form-fdl" class="form-horizontal">

