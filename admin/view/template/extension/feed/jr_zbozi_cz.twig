{{ header }} {{ column_left }} 
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-google-base" data-toggle="tooltip" title="{{ button_save }} " class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }} " data-toggle="tooltip" title="{{ button_cancel }} " class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }} </h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %} 
        <li><a href="{{ breadcrumb.href }} ">{{ breadcrumb.text }} </a></li> 
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %} 
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }} 
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %} 
    {% if success %} 
    <div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }} 
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %} 
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }} </h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }} " method="post" enctype="multipart/form-data" id="form-jr-zbozi" class="form-horizontal">

        <ul class="nav nav-tabs">
          <li class="active"><a href="#tab-general" data-toggle="tab">Hlavní nastavení</a></li>
        </ul>

        <div class="tab-content">
          <!-- tab-general -->
          <div class="tab-pane active" id="tab-general">
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }} </label>
              <div class="col-sm-10">
                <select name="feed_jr_zbozi_cz_status" id="input-status" class="form-control">
                  {% if feed_jr_zbozi_cz_status %} 
                  <option value="1" selected="selected">{{ text_enabled }} </option>
                  <option value="0">{{ text_disabled }} </option>
                  {% else %}   
                  <option value="1">{{ text_enabled }} </option>
                  <option value="0" selected="selected">{{ text_disabled }} </option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_data_feed }} </label>
              <div class="col-sm-10">
                <textarea rows="5" id="input-data-feed" class="form-control" readonly>{{ create_xml }}</textarea>
                <p class="help-block">Adresa pro pravidelnou aktualizaci XML dat: {{ create_xml }} </p>
              </div>
            </div>
            
            <hr />

            <div class="form-group">
              <label class="col-sm-2 control-label">Vypisovat varianty</label>
              <div class="col-sm-10">
                <label class="radio-inline">
                  {% if feed_jr_zbozi_cz_variants %} 
                  <input type="radio" name="feed_jr_zbozi_cz_variants" value="1" checked="checked" />
                  {{ text_yes }} 
                  {% else %}   
                  <input type="radio" name="feed_jr_zbozi_cz_variants" value="1" />
                  {{ text_yes }} 
                  {% endif %} 
                </label>
                <label class="radio-inline">
                  {% if not feed_jr_zbozi_cz_variants %} 
                  <input type="radio" name="feed_jr_zbozi_cz_variants" value="0" checked="checked" />
                  {{ text_no }} 
                  {% else %}   
                  <input type="radio" name="feed_jr_zbozi_cz_variants" value="0" />
                  {{ text_no }} 
                  {% endif %} 
                </label>
              </div>
            </div>

            <hr />

            <h2>Nastavení data dodání</h2>
            <p>Vlevo jsou definované stavy objedávek v eshopu, vpravo do políčka vložte hodnotu, která se bude vkládat do XML do tagu <code>&lt;DELIVERY_DATE&gt;&lt;/DELIVERY_DATE&lt;</code>. Doba vyřízení objednávky – musí být uváděna jako doba od přijetí objednávky do expedice zboží. Číselná hodnota je systémem automaticky převáděna na textové vyjádření. U předobjednávek a připravovaných produktů uvádějte datum uvedení na trh ve formátu RRRR-MM-DD.</p>
            <ul>
              <li>0 (skladem)</li>
              <li>1-3 (do 3 dnů)</li>
              <li>4-7 (do týdne v e-shopu)</li>
              <li>8-30 (více jak týden)</li>
              <li>31 a více (na dotaz)</li>
              <li>datum ve formátu RRRR-MM-DD (předobjednávka)</li>
              <li>-1 (neznámá dostupnost)</li>
            </ul>

            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td>Stav skladu v eshopu</td>
                  <td>Dostupnost v XML pro server zbozi.cz (dodací doba ve dnech, kdy 0 = skladem)</td>
                  <td></td>
                </tr>
              </thead>
              {% for key, value in stock_statuses %}  
              <tr>
                <td>{{ value.name }} </td>
                <td><input type="text" class="form-control" name="feed_jr_zbozi_cz_delivery_date[{{ value.stock_status_id }}]" value="{{ feed_jr_zbozi_cz_delivery_date[value.stock_status_id] ? feed_jr_zbozi_cz_delivery_date[value.stock_status_id] : '' }}" size="80" /></td>
              </tr>
              {% endfor %}
               
            </table>
          </div>
          <!-- //tab-general -->

        </div>
      </form>
    </div>
  </div>
</div>
{{ footer }} 