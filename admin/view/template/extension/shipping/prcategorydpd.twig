{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" id="save_form" form="form-prcategorydpd" value="save" name="action" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        &nbsp;
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
        <h1>{{ heading_title }}</h1>
        <ul class="breadcrumb">
          {% for breadcrumb in breadcrumbs %}
            <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="container-fluid">
      {% if error_warning %}
        <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      {% endif %}
      {% if success %}
        <div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      {% endif %}
      <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ heading_title }}</h3>
          </div>
          <div class="panel-body">
           <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-prcategorydpd" class="form-horizontal">

             <div class="row">
                    <div class="col-sm-2">
                      <ul id="method-list" class="nav nav-pills nav-stacked">
                        <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }} </a></li>
                        <li><a href="#tab-zones" data-toggle="tab">{{ tab_zones }} </a></li>
                        <li><a href="#tab-geozones" data-toggle="tab">{{ tab_geozones }} </a></li>
                      </ul>
                    </div>

                  <div class="col-sm-10">
                    <div id="shipping-container" class="tab-content">
                        <div class="tab-pane active" id="tab-general">
                          <div class="form-group required">
                            <label class="col-sm-2 control-label">{{ entry_title }} </label>
                            <div class="col-sm-10">
                                <input class="form-control" type="text" name="shipping_prcategorydpd_title" value="{{ shipping_prcategorydpd_title }}" />
                            </div>
                          </div>
                          <div class="form-group required">
                            <label class="col-sm-2 control-label">{{ entry_quote_title }} </label>
                            <div class="col-sm-10">
                                <input class="form-control" type="text" name="shipping_prcategorydpd_quote_title" value="{{ shipping_prcategorydpd_quote_title }}" />
                                {% if error_quote_title %}
                                    <div class="text-danger">{{ error_quote_title }}</div>
                                {% endif %}
                            </div>
                          </div>
                          <div class="form-group">
                            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }} </label>
                            <div class="col-sm-10">
                              <select name="shipping_prcategorydpd_status" id="input-status" class="form-control">
                                   {% if shipping_prcategorydpd_status %}
                                    <option value="1" selected="selected">{{ text_enabled }} </option>
                                    <option value="0">{{ text_disabled }} </option>
                                  {% else %}
                                    <option value="1">{{ text_enabled }} </option>
                                    <option value="0" selected="selected">{{ text_disabled }} </option>
                                  {% endif %}
                              </select>
                             </div>
                          </div>
                          <div class="form-group">
                            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }} </label>
                            <div class="col-sm-10">
                              <input type="text" name="shipping_prcategorydpd_sort_order" value="{{ shipping_prcategorydpd_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
                            </div>
                          </div>

                        </div> <!--end of tab general-->
                        <div id="tab-zones" class="tab-pane">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered table-hover">
                                    <thead>
                                    <tr>
                                        <td class="left">{{ entry_country }} / {{ entry_zone }}</td>
                                        <td class="left">{{ entry_enabled_cities }}</td>
                                        <td class="left">{{ entry_disabled_cities }}</td>
                                        <td></td>
                                    </tr>
                                    </thead>
                                    {% for prcategorydpd_zone in prcategorydpd_zones %}
                                        <tbody id="zone-{{ prcategorydpd_zone.prcategorydpd_zone_id }}">
                                            <tr>
                                                <td class="left">
                                                    {{ prcategorydpd_zone.country_name }}, {{ prcategorydpd_zone.zone_name }}
                                                </td>
                                                <td class="left">
                                                    <span>{{ prcategorydpd_zone.enabled_cities }}</span>
                                                </td>
                                                <td class="left">
                                                    <span>{{ prcategorydpd_zone.disabled_cities }}</span>
                                                </td>
                                                <td class="left">
                                                    <a href="index.php?route=extension/shipping/prcategorydpd/edit&type=zone&zone_id={{ prcategorydpd_zone.prcategorydpd_zone_id }}&user_token={{ user_token }}" title="{{ button_edit }}" class="btn btn-primary">
                                                        <i class="fa fa-pencil"></i>
                                                    </a>
                                                    <a onclick="removeZone({{ prcategorydpd_zone.prcategorydpd_zone_id }}, 'zone'); return false;" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></a>
                                                </td>
                                            </tr>
                                        </tbody>
                                    {% endfor %}
                                    <tfoot>
                                    <tr>
                                        <td colspan="3"></td>
                                        <td class="text-left">
                                            <a href="index.php?route=extension/shipping/prcategorydpd/edit&type=zone&user_token={{ user_token }}" title="{{ button_add }}" class="btn btn-primary">
                                                <i class="fa fa-plus-circle"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                        <div id="tab-geozones" class="tab-pane">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered table-hover">
                                    <thead>
                                        <tr>
                                          <td class="text-left">{{ entry_geo_zone }}</td>
                                          <td></td>
                                        </tr>
                                    </thead>
                                    {% for prcategorydpd_geo_zone in prcategorydpd_geo_zones %}
                                        <tbody id="geozone-{{ prcategorydpd_geo_zone.prcategorydpd_geozone_id }}">
                                        <tr>
                                            <td class="left">
                                                {{ prcategorydpd_geo_zone.geo_zone_name }}
                                            </td>
                                            <td class="left">
                                                <a href="index.php?route=extension/shipping/prcategorydpd/edit&type=geozone&zone_id={{ prcategorydpd_geo_zone.prcategorydpd_geozone_id }}&user_token={{ user_token }}" title="{{ button_edit }}" class="btn btn-primary">
                                                    <i class="fa fa-pencil"></i>
                                                </a>
                                                <a onclick="removeZone({{ prcategorydpd_geo_zone.prcategorydpd_geozone_id }}, 'geozone'); return false;" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></a>
                                            </td>
                                        </tr>
                                        </tbody>
                                    {% endfor %}
                                    <tfoot>
                                    <tr>
                                      <td></td>
                                      <td class="text-left">
                                        <a href="index.php?route=extension/shipping/prcategorydpd/edit&type=geozone&user_token={{ user_token }}" title="{{ button_add }}" class="btn btn-primary">
                                            <i class="fa fa-plus-circle"></i>
                                        </a>
                                      </td>
                                    </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                     </div>
                   </div>
                 </div>
               </div>
            </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
    function removeZone(zone_id, type) {
        if (confirm('{{ text_confirm }}')) {
            $.get('index.php?route=extension/shipping/prcategorydpd/delete_zone&type=' + type + '&zone_id=' + zone_id + '&user_token={{ user_token }}',
                    function(json) {
                        if (json.error) {
                            alert(json.error);
                        } else {
                            $('#' + type + '-' + zone_id).remove();
                        }
                    }, 'json');
        }
    }
//--></script>
{{ footer }}
