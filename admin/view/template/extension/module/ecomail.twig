{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-account" data-toggle="tooltip" title="{{ button_save }}"
                        class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}"
                   class="btn btn-default"><i class="fa fa-reply"></i></a></div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumbs in breadcrumb %}
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if error_warning %}
        <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-account"
                      class="form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="input-ecomail_api_key">{{ entry_api_key }}</label>
                        <div class="col-sm-10">
                            <input type="text" name="ecomail_api_key" value="{{ ecomail_api_key }}"
                                   placeholder="{{ entry_api_key }}" id="input-ecomail_api_key" class="form-control"/>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="input-ecomail_list_id">{{ entry_list_id }}</label>
                        <div class="col-sm-10">
                            <select name="ecomail_list_id" id="input-ecomail_list_id" class="form-control">
                                {% for optionsListId in list %}
                                {% if ecomail_list_id == list.value %}
                                <option value="{{ list.value }}"
                                        selected="selected">{{ list.label }}</option>
                                {% else %}
                                <option value="{{ list.value }}">{{ list.label }}</option>
                                {% endif %}
                                {% endfor %}
                            </select>
                            <span>Vyberte list do kterého budou zapsáni noví zákazníci</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="input-ecomail_app_id">{{ entry_app_id }}</label>
                        <div class="col-sm-10">
                            <input type="text" name="ecomail_app_id" value="{{ ecomail_app_id }}"
                                   placeholder="{{ entry_app_id }}" id="input-ecomail_app_id" class="form-control"/>
                            <span>Tento údaj slouží pro aktivaci funkce Trackovací kód</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                        <div class="col-sm-10">
                            <select name="ecomail_status" id="input-status" class="form-control">
                                {% if ecomail_status %}
                                <option value="1" selected="selected">{{ text_enabled }}</option>
                                <option value="0">{{ text_disabled }}</option>
                                {% else %}
                                <option value="1">{{ text_enabled }}</option>
                                <option value="0" selected="selected">{{ text_disabled }}</option>
                                {% endif %}
                            </select>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{{ footer }}
