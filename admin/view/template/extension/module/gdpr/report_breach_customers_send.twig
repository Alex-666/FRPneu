{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title_customers_send_emails }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-envelope"></i> {{ heading_detailed_customers_send_emails }}</h3>
      </div>

      {% if not success %}
        <div class="alert alert-info">{{ text_notifications_pending }} <span class="badge">{{ notifications_pending }}</span></div>
        <div class="alert alert-success">{{ text_notifications_emailed }} <span class="badge">{{ notifications_emailed }}</span></div>
        <div class="alert alert-default">{{ text_instructions_customers_send_emails }}</div>
      {% endif %}

      <div class="panel-body">

        <!-- SUCCESS MESSAGE -->
        {% if success %}
        <div>
          <div class="alert alert-success"><h3>{{ text_success_email_batch }}</h3></div>
        </div>
        {% endif %}

        {% if not success %}
        <form class="form-horizontal" method="post" enctype="multipart/form-data">
          <!-- BATCH SIZE -->
          <p>{{ help_batch_size }}</p>
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-batch-size">{{ entry_batch_size }}<span data-toggle="tooltip" title="{{ help_batch_size }}"></label>
              <div class="col-sm-10">
                <select name="batch-size" id="input-batch-size" class="form-control">
                  {% for batch_size in batch_sizes %}
                    {% if batch_size.default %}
                      <option value="{{ batch_size.id }}" selected>{{ batch_size.name }}</option>
                    {% else %}
                      <option value="{{ batch_size.id }}">{{ batch_size.name }}</option>
                    {% endif %}
                  {% endfor %}
                </select>
              </div>
          </div>

          <!-- MAXIMUM RUNTIME -->
          <p>{{ help_max_runtime }}</p>
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-max-runtime">{{ entry_max_runtime }}<span data-toggle="tooltip" title="{{ help_max_runtime }}"></label>
              <div class="col-sm-10">
                <select name="max-runtime" id="input-max-runtime" class="form-control">
                  {% for runtime in runtimes %}
                    {% if runtime.default %}
                      <option value="{{ runtime.id }}" selected>{{ runtime.name }}</option>
                    {% else %}
                      <option value="{{ runtime.id }}">{{ runtime.name }}</option>
                    {% endif %}
                  {% endfor %}
                </select>
              </div>
          </div>

          <!-- Send modal -->
          <div>
            <div id="modal-email" class="text-left" colspan="100%" style="display:none;">

              <div id="modal-error">
              </div>

              <div id="modal-progress">
              </div>

            </div>
          </div>
          <!-- Send modal -->

          <div class="pull-right" style="min-width:50%;">
            <button type="submit" id="button-email" data-loading-text="{{ text_loading }}" data-toggle="tooltip" title="{{ button_email }}" class="btn btn-lg btn-primary"><i class="fa fa-envelope" ></i>  {{ text_email }}</button>
          </div>

        </form>
        {% endif %}
      </div>

      {% if not success %}
        <h3>{{ text_header_cron }}</h3>
        <div class="alert alert-default"><h6>{{ text_instructions_cron }}</h6>
          <div class="alert alert-warning"><strong><span id="cron-url">{{ cron_url }}</span></strong></div>
        </div>

        <h3>{{ text_header_log }}</h3>
        <div class="alert alert-default"><h6>{{ text_instructions_log }}</h6>
          <div class="alert alert-default"><strong><span id="log-path">{{ log_path }}</span></strong></div>
        </div>
      {% endif %}

    </div>

    <div id="error-bottom">
      <div class="container-fluid">
      </div>
    </div>
  </div>

  <script type="text/javascript"><!--
$('#input-message').summernote({
	height: 300
});
//--></script>
  <script type="text/javascript"><!--
$('select[name=\'to\']').on('change', function() {
	$('.to').hide();

	$('#to-' + this.value.replace('_', '-')).show();
});

$('select[name=\'to\']').trigger('change');
//--></script>
  <script type="text/javascript"><!--

function send(url) {

	var batch_size = $('select[name=\'batch-size\']').val();
  var max_runtime = $('select[name=\'max-runtime\']').val();

  console.log(batch_size);
  console.log(max_runtime);

  for (i = 0; i < batch_size; i++) {
    $.ajax({
      url: url,
      type: 'post',
      data: '',
      dataType: 'json',
      beforeSend: function() {
        $('#button-send').button('loading');
        $('#modal-email').show();
      },
      complete: function() {
        $('#button-send').button('reset');
        $('#modal-progress').html('<div class=\"alert alert-info\"<p>Emailed <strong>' + i + '</strong> out of ' + batch_size + '</p></div>');
        $('#modal-progress').html('progress');
      },
      success: function(json) {
        $('.alert, .text-danger').remove();

        if (json['error']) {
          if (json['error']['subject']) {
            $('input[name=\'subject\']').after('<div class="text-danger">' + json['error']['subject'] + '</div>');
          }
        }

        if (json['success']) {
          $('#modal-progress').html('<div class="alert alert-info"<p>Emailed <strong>' + i + '</strong> out of ' + batch_size + '</p></div>');
        }
      }
    });
    console.log(i);
  }

  $('#modal-email').hide();

}
//--></script></div>
{{ footer }}
