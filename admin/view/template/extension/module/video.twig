{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="pull-right">
				<button type="submit" form="form-video" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
				<a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
			<h1>{{ heading_title }}</h1>
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
				<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>
	<div class="container-fluid">
		{% if error_warning %}
		<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
			<button type="button" class="close" data-dismiss="alert">&times;</button>
		</div>
		{% endif %}
		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
			</div>
			<div class="panel-body">
				<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-video" class="form-horizontal">

								<div class="form-group">
									<label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
									<div class="col-sm-10">
										<select name="video_status" id="input-status" class="form-control">
											{% if video_status %}
												<option value="1" selected="selected">{{ text_enabled }}</option>
												<option value="0">{{ text_disabled }}</option>
											{% else %}
												<option value="1">{{ text_enabled }}</option>
												<option value="0" selected="selected">{{ text_disabled }}</option>
											{% endif %}
										</select>
									</div>
								</div>
								<div class="form-group">
									<label class="col-sm-2 control-label" for="thumb-image">{{ entry_image }}</label>
									<div class="col-sm-10">
										<a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ video_thumb }}" alt="" title="" data-placeholder=""></a>
										<input type="hidden" name="video_image" value="{{ video_image }}" id="input-image">
									</div>
								</div>
								<div class="form-group">
								<label class="col-sm-2 control-label" for="input-video-play-button">{{ entry_btn }}</label>
								<div class="col-sm-10">
									<div style="width:80px; float:left; margin-right:10px;"><input type="radio" name="video_btn" value="1" {% if video_btn == 1 %} {{ 'checked="checked"' }} {% endif %} /><div style="background: url('../image/play_button/1.png') repeat-x; width:50px; height:50px; float:right; background-size: contain;"></div></div>
									<div style="width:80px; float:left; margin-right:10px;"><input type="radio" name="video_btn" value="2" {% if video_btn == 2 %} {{ 'checked="checked"' }} {% endif %} /><div style="background: url('../image/play_button/2.png') repeat-x; width:50px; height:50px; float:right; background-size: contain;"></div></div>
									<div style="width:80px; float:left; margin-right:10px;"><input type="radio" name="video_btn" value="3" {% if video_btn == 3 %} {{ 'checked="checked"' }} {% endif %} /><div style="background: url('../image/play_button/3.png') repeat-x; width:50px; height:50px; float:right; background-size: contain;"></div></div>
									<div style="width:80px; float:left; margin-right:10px;"><input type="radio" name="video_btn" value="4" {% if video_btn == 4 %} {{ 'checked="checked"' }} {% endif %} /><div style="background: url('../image/play_button/4.png') repeat-x; width:50px; height:50px; float:right; background-size: contain;"></div></div>
									<div style="width:80px; float:left; margin-right:10px;"><input type="radio" name="video_btn" value="5" {% if video_btn == 5 %} {{ 'checked="checked"' }} {% endif %} /><div style="background: url('../image/play_button/5.png') repeat-x; width:50px; height:50px; float:right; background-size: contain;"></div></div>
									<div style="width:80px; float:left; margin-right:10px;"><input type="radio" name="video_btn" value="6" {% if video_btn == 6 %} {{ 'checked="checked"' }} {% endif %} /><div style="background: url('../image/play_button/6.png') repeat-x; width:50px; height:50px; float:right; background-size: contain;"></div></div>
									<div style="width:80px; float:left; margin-right:10px;"><input type="radio" name="video_btn" value="7" {% if video_btn == 7 %} {{ 'checked="checked"' }} {% endif %} /><div style="background: url('../image/play_button/7.png') repeat-x; width:50px; height:50px; float:right; background-size: contain;"></div></div>
									<div style="width:80px; float:left; margin-right:10px;"><input type="radio" name="video_btn" value="8" {% if video_btn == 8 %} {{ 'checked="checked"' }} {% endif %} /><div style="background: url('../image/play_button/8.png') repeat-x; width:50px; height:50px; float:right; background-size: contain;"></div></div>
									<div style="width:80px; float:left; margin-right:10px;"><input type="radio" name="video_btn" value="9" {% if video_btn == 9 %} {{ 'checked="checked"' }} {% endif %} /><div style="background: url('../image/play_button/9.png') repeat-x; width:50px; height:50px; float:right; background-size: contain;"></div></div>
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="video_autoplay">{{ entry_autoplay }}</label>
								<div class="col-sm-10">
									<div class="btn-group" data-toggle="buttons">
										{% if video_autoplay %}
											<label class="btn btn-default active">
												<input type="radio" name="video_autoplay" value="1" autocomplete="off" checked="checked" />{{ text_enabled }}
											</label>
											<label class="btn btn-danger btn-default">
												<input type="radio" name="video_autoplay" value="0" autocomplete="off"/>{{ text_disabled }}
											</label>
										{% else %}
											<label class="btn btn-default">
												<input type="radio" name="video_autoplay" value="1" autocomplete="off" />{{ text_enabled }}
											</label>
											<label class="btn btn-danger btn-default active">
												<input type="radio" name="video_autoplay" value="0" autocomplete="off" checked="checked" />{{ text_disabled }}
											</label>
										{% endif %}
									</div>
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="video_loop">{{ entry_loop }}</label>
								<div class="col-sm-10">
									<div class="btn-group" data-toggle="buttons">
										{% if video_loop %}
											<label class="btn btn-default active">
												<input type="radio" name="video_loop" value="1" autocomplete="off" checked="checked" />{{ text_enabled }}
											</label>
											<label class="btn btn-danger btn-default">
												<input type="radio" name="video_loop" value="0" autocomplete="off"/>{{ text_disabled }}
											</label>
										{% else %}
											<label class="btn btn-default">
												<input type="radio" name="video_loop" value="1" autocomplete="off" />{{ text_enabled }}
											</label>
											<label class="btn btn-danger btn-default active">
												<input type="radio" name="video_loop" value="0" autocomplete="off" checked="checked" />{{ text_disabled }}
											</label>
										{% endif %}
									</div>
								</div>
							</div>

							<div class="form-group">
				 				<label class="col-sm-2 control-label" for="video_branding">{{ entry_branding }}</label>
								<div class="col-sm-10">
									<div class="btn-group" data-toggle="buttons">
										{% if not video_branding %}
											<label class="btn btn-default active">
												<input type="radio" name="video_branding" value="0" autocomplete="off" checked="checked" />{{ text_enabled }}
											</label>
											<label class="btn btn-danger btn-default">
												<input type="radio" name="video_branding" value="1" autocomplete="off"/>{{ text_disabled }}
											</label>
										{% else %}
											<label class="btn btn-default">
												<input type="radio" name="video_branding" value="0" autocomplete="off" />{{ text_enabled }}
											</label>
											<label class="btn btn-danger btn-default active">
												<input type="radio" name="video_branding" value="1" autocomplete="off" checked="checked" />{{ text_disabled }}
											</label>
										{% endif %}
									</div>
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="video_rel">{{ entry_rel }}</label>
								<div class="col-sm-10">
									<div class="btn-group" data-toggle="buttons">
										{% if video_rel %}
											<label class="btn btn-default active">
												<input type="radio" name="video_rel" value="1" autocomplete="off" checked="checked" />{{ text_enabled }}
											</label>
											<label class="btn btn-danger btn-default">
												<input type="radio" name="video_rel" value="0" autocomplete="off"/>{{ text_disabled }}
											</label>
										{% else %}
											<label class="btn btn-default">
												<input type="radio" name="video_rel" value="1" autocomplete="off" />{{ text_enabled }}
											</label>
											<label class="btn btn-danger btn-default active">
												<input type="radio" name="video_rel" value="0" autocomplete="off" checked="checked" />{{ text_disabled }}
											</label>
										{% endif %}
									</div>
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="video_fs">{{ entry_fs }}</label>
								<div class="col-sm-10">
									<div class="btn-group" data-toggle="buttons">
										{% if video_fs %}
											<label class="btn btn-default active">
												<input type="radio" name="video_fs" value="1" autocomplete="off" checked="checked" />{{ text_enabled }}
											</label>
											<label class="btn btn-danger btn-default">
												<input type="radio" name="video_fs" value="0" autocomplete="off"/>{{ text_disabled }}
											</label>
										{% else %}
											<label class="btn btn-default">
												<input type="radio" name="video_fs" value="1" autocomplete="off" />{{ text_enabled }}
											</label>
											<label class="btn btn-danger btn-default active">
												<input type="radio" name="video_fs" value="0" autocomplete="off" checked="checked" />{{ text_disabled }}
											</label>
										{% endif %}
									</div>
								</div>
							</div>
				</form>
			</div>
																																																																													<div style="background: #233746;color: #ffffff;font-size: 130%;padding: 10px;border-color: #233746;border-radius: 3px;margin-top: 20px;">Еще больше модулей для Opencart 3.x на нашем сайте <a style="color: #fffc00;" href="https://opencart3x.ru/">opencart3x.ru </a>!</div>
			<style>
			#form-video .btn-default.active.focus, #form-video .btn-default.active:focus, #form-video .btn-default.active:hover, #form-video .btn-default:active.focus, #form-video .btn-default:active:focus, #form-video .btn-default:active:hover{
		        color: #fff;
		        background-color: #398439;
		        border-color: #255625;
		    }
		    #form-video .btn-default.active, #form-video .btn-default:active {
		        background-color: #75a74d;
		        border-color: #5c843d;
		        color: #fff;
		    }
		    #form-video .btn-default.btn-danger {
		        color: #555555;
		        background-color: #ffffff;
		        border-color: #cccccc;
		    }
		    #form-video .btn-default.btn-danger.active.focus, #form-video .btn-default.btn-danger.active:focus, #form-video .btn-default.btn-danger.active:hover, #form-video .btn-default.btn-danger:active.focus, #form-video .btn-default.btn-danger:active:focus, #form-video .btn-default.btn-danger:active:hover{
		        color: #ffffff;
		        background-color: #f23b3b;
		        border-color: #ea1010;
		    }
		    #form-video .btn-default.btn-danger.active, #form-video .btn-default.btn-danger:active {
		        color: #ffffff;
		        background-color: #f56b6b;
		        border-color: #f24545;
		    }
			</style>
		</div>
	</div>
</div>
{{ footer }}
		
		