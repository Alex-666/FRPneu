{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="pull-right">
				<button type="submit" form="form-payment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
				<a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
			<h1>{{ heading_title }}</h1>
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
				<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>
	<div class="container-fluid">
		{% if error_warning %}
		<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
			<button type="button" class="close" data-dismiss="alert">&times;</button>
		</div>
		{% endif %}
		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
			</div>
			<div class="panel-body">
				<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment" class="form-horizontal">

					{# dynamicka konfiguracni pole #}
					{% for configField in configInfo.configFields %}
						{% if configField.type != ConfigFieldType.subMethodsSelection %}
							<div class="form-group">
								<label class="col-sm-2 control-label">{{ configField.label }}</label>
								<div class="col-sm-10">
									{% if configField.type == ConfigFieldType.text %}
										<input type="text" name="uniadapter_{{ configField.name }}" value="{{ attribute(uniadapter_, configField.name) }}"  class="form-control" />
									{% elseif configField.type == ConfigFieldType.choice %}
										<select name="uniadapter_{{ configField.name }}"  class="form-control" >
											{% for val, lab in configField.choiceItems %}
												<option value="{{ val }}" {% if val is not null and val == attribute(uniadapter_, configField.name) %} selected="selected" {% endif%}>{{ lab }}</option>
											{% endfor %}}
										</select>
									{% elseif configField.type == ConfigFieldType.orderStatus %}
										<select name="uniadapter_{{ configField.name }}" class="form-control" >
											{% for order_status in order_statuses %}
												{% if order_status.order_status_id == attribute(uniadapter_, configField.name) %}
													<option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
												{% else %}
													<option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
												{% endif %}
											{% endfor %}
										</select>
									{% endif %}
								</div>
							</div>
						{% endif %}
					{% endfor %}



					<div class="form-group">
						<label class="col-sm-2 control-label" for="input-geo-zone">{{ entry_geo_zone }}</label>
						<div class="col-sm-10">
							<select name="uniadapter_geo_zone_id" id="input-geo-zone" class="form-control">
								 <option value="0">{{ text_all_zones }}</option>
								{% for geo_zone in geo_zones %}
								{% if geo_zone.geo_zone_id == uniadapter_geo_zone_id %}
								<option value="{{ geo_zone.geo_zone_id }}" selected="selected">{{ geo_zone.name }}</option>
								{% else %}
								<option value="{{ geo_zone.geo_zone_id }}">{{ geo_zone.name }}</option>
								{% endif %}
								{% endfor %}
							</select>
						</div>
					</div>
					<div class="form-group">
						<label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
						<div class="col-sm-10">
							<select name="uniadapter_status" id="input-status" class="form-control">
								{% if uniadapter_status %}
									<option value="1" selected="selected">{{ text_enabled }}</option>
									<option value="0">{{ text_disabled }}</option>
								{% else %}
									<option value="1">{{ text_enabled }}</option>
									<option value="0" selected="selected">{{ text_disabled }}</option>
								{% endif %}
							</select>
						</div>
					</div>


					<div class="form-group">
						<label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
						<div class="col-sm-10">
							<input type="text" name="uniadapter_sort_order" value="{{ uniadapter_sort_order }}" placeholder="{{ uniadapter_sort_order }}" id="input-sort-order" class="form-control" />
						</div>
					</div>


				</form>
			</div>
		</div>
	</div>
</div>
{{ footer }}
