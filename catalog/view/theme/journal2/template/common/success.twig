{{ header }}
<div id="container" class="container j-container success-page">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li itemscope itemtype="http://data-vocabulary.org/Breadcrumb"><a href="{{ breadcrumb.href }}" itemprop="url"><span itemprop="title">{{ breadcrumb.text }}</span></a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}{{ column_right }}
    {% if column_left and column_right %}
      {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
      {% set class = 'col-sm-9' %}
    {% else %}
      {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">
      {{ content_top }}
      <h1 class="heading-title">{{ heading_title }}</h1>
      <div style="float:left; margin: 0 20px">
	  <img width="115" src="/image/icon-success.svg"/>
	  </div>
	  <div class="order-done">
      {{ text_message }}
	  </div>
      <div class="buttons">
        <div class="pull-right"><a href="{{ continue }}" class="btn-primary button">{{ button_continue }}</a></div>
      </div>
      {{ content_bottom }}
    </div>
  </div>
</div>
{% if order_id  %}
  <script type="text/javascript">
    dataLayer.push({'event': 'order_cart' });
  </script>
{% endif %}
{% if order_id  %}
    <!-- Event snippet for Google Ads Website Conversion Tag conversion page -->
    <script>

        {% set totalPrice_AW = 0 %}
        {% for product in products %}
        {% set totalPrice_AW = totalPrice_AW + product.price * product.quantity %}
        {% endfor %}

        <!-- Měřicí kód Sklik.cz -->
        var seznam_cId = 100068724;
        var seznam_value = {{ totalPrice_AW }};
    </script>
    <script type="text/javascript" src="https://www.seznam.cz/rs/static/rc.js" async></script>
{% endif %}
{{ footer }}

