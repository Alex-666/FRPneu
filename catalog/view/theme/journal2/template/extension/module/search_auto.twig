                                });

                                hide2.addEventListener("click", () => {
                                    content2.style.display = "none";
                                    show2.style.display = "block";
                                    hide2.style.display = "none";
                                });
                            </script>
                        </div>-->


                    </div>
                </form>
            </div>
            <div class="tab-pane tab-content{% if tab == 'auto' %} active{% endif %}" id="tab-auto">
                <form action="{{ action }}" class="form-horizontal">
                    <input type="hidden" name="tab" value="auto">
                    {% if limit %}<input type="hidden" name="limit" value="{{ limit }}">{% endif %}
                    <div class="row">
                        <div class="xs-100 sm-50 md-50 lg-25 xl-25">
                            <div class="form-group">
                                <label for="input-vendor">
                                    <select name="vendor" id="input-vendor" class="form-control open-auto-popup" data-auto-popup="vendor">
                                        <option value="">{{ entry_vendor }}</option>
                                        {% for param in auto_vendor_choices %}
                                            {% if param.vendor == auto_vendor %}
                                                <option value="{{ param.vendor }}"
                                                        selected="selected">{{ param.vendor }}</option>
                                            {% else %}
                                                <option value="{{ param.vendor }}">{{ param.vendor }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </label>
                            </div>
                        </div>
                        <div class="xs-100 sm-50 md-50 lg-25 xl-25">
                            <div class="form-group">
                                <label for="input-model">
                                    <select name="model" id="input-model" data-auto-popup="model"
                                            class="form-control open-auto-popup"{% if not auto_vendor %} disabled="disabled"{% endif %}>
                                        <option value="">{{ entry_model }}</option>
                                        {% for param in auto_model_choices %}
                                            {% if param.model == auto_model %}
                                                <option value="{{ param.model }}"
                                                        selected="selected">{{ param.model }}</option>
                                            {% else %}
                                                <option value="{{ param.model }}">{{ param.model }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </label>
                            </div>
                        </div>
                        <div class="xs-100 sm-50 md-50 lg-25 xl-25">
                            <div class="form-group">
                                <label for="input-year">
                                    <select name="year" id="input-year" data-auto-popup="year"
                                            class="form-control open-auto-popup"{% if not auto_model %} disabled="disabled"{% endif %}>
                                        <option value="">{{ entry_year }}</option>
                                        {% for param in auto_year_choices %}
                                            {% if param.year == auto_year %}
                                                <option value="{{ param.year }}"
                                                        selected="selected">{{ param.year }}</option>
                                            {% else %}
                                                <option value="{{ param.year }}">{{ param.year }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </label>
                            </div>
                        </div>
                        <div class="xs-100 sm-50 md-50 lg-25 xl-25">
                            <div class="form-group">
                                <label for="input-mod">
                                    <select name="mod" id="input-mod" data-auto-popup="mod"
                                            class="form-control open-auto-popup"{% if not auto_year %} disabled="disabled"{% endif %}>
                                        <option value="">{{ entry_mod }}</option>
                                        {% for param in auto_mod_choices %}
                                            {% if param.modification == auto_mod %}
                                                <option value="{{ param.modification }}"
                                                        selected="selected">{{ param.modification }}</option>
                                            {% else %}
                                                <option value="{{ param.modification }}">{{ param.modification }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </label>
                            </div>
                        </div>
                        <div class="xs-100 sm-50 md-50 lg-25 xl-25 btns">
                            <input type="submit" class="button{% if not auto_year %} disabled"{% endif %}"
                            value="{{ btn_find }}"{% if not auto_year %} disabled="disabled"{% endif %}>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endif %}
