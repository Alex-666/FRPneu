                                    <select name="diameter" id="input-disc-diameter" class="form-control">
                                        <option value="">{{ entry_diameter }}</option>
                                        {% for param in disc_diameter_choices %}
                                            {% if param == disc_diameter %}
                                                <option value="{{ param }}" selected="selected">{{ param }}</option>
                                            {% else %}
                                                <option value="{{ param }}">{{ param }}</option>
