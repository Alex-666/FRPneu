                                                        selected="selected">{{ param|replace({'.':','}) }}</option>
                                            {% else %}
                                                <option value="{{ param }}">{{ param|replace({'.':','}) }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </label>
                            </div>
                        </div>
                        <!--<div id="tabs-hidden2" style="display: none">-->
                        <div class="4 xs-45 sm-50 md-50 lg-33 xl-33">
                            <div class="form-group">
                                <label for="input-disc-width" class="poster-tire-help">
                                        <span class="descr-tire-help">
                                            {{ entry_width_help_disk }}
                                        </span>

                                    <select name="width" id="input-disc-width" class="form-control">
                                        <option value="">{{ entry_width }}</option>
                                        {% for param in disc_width_choices %}
                                            {% if param == disc_width %}
                                                <option value="{{ param }}"
                                                        selected="selected">{{ param|replace({'.':','}) }}</option>
                                            {% else %}
                                                <option value="{{ param }}">{{ param|replace({'.':','}) }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </label>
                            </div>
                        </div>
                        <div class="5 xs-45 sm-50 md-50 lg-33 xl-33">
                            <div class="form-group">
                                <label for="input-disc-dia" class="poster-tire-help">
                                        <span class="descr-tire-help">
                                            {{ entry_dia_help }}
                                        </span>
                                    <select name="dia" id="input-disc-dia" class="form-control">
                                        <option value="">{{ entry_dia }}</option>
                                        {% for param in disc_dia_choices %}
                                            {% if param == disc_dia %}
                                                <option value="{{ param }}"
                                                        selected="selected">{{ param|replace({'.':','}) }}</option>
                                            {% else %}
                                                <option value="{{ param }}">{{ param|replace({'.':','}) }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </label>
                            </div>
                        </div>
                        <div class="6 xs-45 sm-50 md-50 lg-33 xl-33">
                            <div class="form-group">
                                <label for="input-disc-manufacturer" class="poster-tire-help">
                                    <select name="manufacturer" id="input-disc-manufacturer" class="form-control">
                                        <option value="">{{ entry_manufacturer }}</option>
                                        {% for param in disc_manufacturer_choices %}
                                            {% if param.name == disc_manufacturer %}
                                                <option value="{{ param.name }}"
                                                        selected="selected">{{ param.name }}</option>
                                            {% else %}
                                                <option value="{{ param.name }}">{{ param.name }}</option>
                                            {% endif %}
