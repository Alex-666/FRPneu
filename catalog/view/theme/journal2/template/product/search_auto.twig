{{ header }}
<div id="container" class="container j-container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li itemscope itemtype="http://data-vocabulary.org/Breadcrumb"><a href="{{ breadcrumb.href }}" itemprop="url"><span itemprop="title">{{ breadcrumb.text }}</span></a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}{{ column_right }}
    {% if column_left and column_right %}
      {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
      {% set class = 'col-sm-9' %}
    {% else %}
      {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">
      <h1 class="heading-title">{{ heading_title }}</h1>
      {{ content_top }}
        <div class="box-heading" style="font-size: 20px;">{{ vendor }} > {{ model }} > {{ year }} > {{ mod }}</div>
        <div class="result-auto row">
            {% if auto.pcd or auto.dia or auto.nut %}
                <h3>{{ text_disc_params }}</h3>
                <ul class="general">
                    {% if auto.pcd %}
                    <p>{{ text_pcd }}:&nbsp;<b>{{ auto.pcd }}</b></p>
                    {% endif %}
                    {% if auto.dia %}
                    <p>{{ text_dia }}:&nbsp;<b>{{ auto.dia }} {{ text_mm }}</b></p>
                    {% endif %}
                    {% if auto.nut %}
                    <p>{{ text_nut }}:&nbsp;<b>{{ auto.nut }}</b></p>
                    {% endif %}
                </ul>
                <p>&nbsp;</p>
            {% endif %}

            {% if data.disc %}
            <div class="xs-100 sm-100 md-100 lg-50 xl-50" style="padding-right: 10px;">
                <h3><img src="/image/catalog/icons/Vyber_podle_auta/FR_Pneu_Pneuservis_alu_kola_drk_trnspr.png" width="40" style="margin-top: -10px;"> <span style="vertical-align: top;">{{ text_recom_discs }}</span></h3>
                <table class="table table-bordered table-hover list">
                    <tbody>
                    {% for r, items in data.disc %}
                        {% for item in items %}
                            {% if loop.first %}
                            <tr class="diameter">
                                <td class="caption" style="width: 25%"><h2>R{{ r }}</h2></td>
                                {% if item.0  %}
                                    <td><b>{{text_front_axle }}</b></td>
                                    <td><b>{{text_rear_axle }}</b></td>
                                {% else %}
                                    <td><b>{{text_front_rear_axle }}</b></td>
                                {% endif %}
                            </tr>
                            {% endif %}
                        <tr class="item">
                            <td class="type">{{ item.type }}</td>
                            {% if item.0  %}
                            <td class="size front"><a target="_blank" href="{{ item.0.url }}">{{ item.0.n }}</a></td>
                            <td class="size rear"><a target="_blank" href="{{ item.1.url }}">{{ item.1.n }}</a></td>
                            {% else %}
                            <td class="size front-rear"><a target="_blank" href="{{ item.url }}">{{ item.n }}</a></td>
                            {% endif %}
                        </tr>
                        {% endfor %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}

            {% if data.tire %}
            <div class="xs-100 sm-100 md-100 lg-50 xl-50" style="padding-right: 10px;">
                <h3><img src="/image/catalog/icons/Vyber_podle_auta/FR_Pneu_Vyber_Pneumatik_icon_png_drk_trnspr.png" width="40" style="margin-top: -10px;"> <span style="vertical-align: top;">{{ text_recom_tires }}</span></h3>
                <table class="table table-bordered table-hover list">
                    <tbody>
                    {% for r, items in data.tire %}
                        {% for item in items %}
                            {% if loop.first %}
                            <tr class="diameter">
                                <td class="caption" style="width: 25%"><h2>R{{ r }}</h2></td>
                                {% if item.0  %}
                                    <td><b>{{text_front_axle }}</b></td>
                                    <td><b>{{text_rear_axle }}</b></td>
                                {% else %}
                                    <td><b>{{text_front_rear_axle }}</b></td>
                                {% endif %}
                            </tr>
                            {% endif %}
                        <tr class="item">
                            <td class="type">{{ item.type }}</td>
                            {% if item.0 %}
                            <td class="size front"><a target="_blank" href="{{ item.0.url }}">{{ item.0.n }}</a></td>
                            <td class="size rear"><a target="_blank" href="{{ item.1.url }}">{{ item.1.n }}</a></td>
                            {% else %}
                            <td class="size front-rear" colspan="2"><a target="_blank" href="{{ item.url }}">{{ item.n }}</a></td>
                            {% endif %}
                        </tr>
                        {% endfor %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>


          {% if not data.disc and not data.tire %}
            <div class="xs-100"><p>{{ text_empty }}</p></div>
          {% endif %}
    </div>
  </div>
</div>
{{ footer }}
