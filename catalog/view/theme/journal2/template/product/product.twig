              <script>
                /* quantity buttons */
                var $input = $('.cart input[name="quantity"]');

                function up() {
                    var val = parseInt($input.val(), 10) + 1 || parseInt($input.attr('data-min-value'), 10);
                    $input.val(val);
                }

                function down() {
                    var val = parseInt($input.val(), 10) - 1 || 0;
                    var min = parseInt($input.attr('data-min-value'), 10) || 1;
                    $input.val(Math.max(val, min));
                }

                $('<a href="javascript:;" class="journal-stepper">-</a>').insertAfter('.cart #input-quantity-flex').click(down);
                $('<a href="javascript:;" class="journal-stepper">+</a>').insertAfter('.cart #input-quantity-flex').click(up);
                $input.keydown(function (e) {
                    if (e.which === 38) {
                        up();
                        return false;
                    }
                    if (e.which === 40) {
                        down();
                        return false;
                    }
                });
              </script>
