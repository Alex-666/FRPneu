{{ header }}
<div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}	
  </ul> 
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>{{ heading_title }}</h1> 
	   <div class="pull-right">
		<a style="background:{{ titlebgcolor }}; border:solid 1px {{ titlebgcolor }}; color:{{ titlecolor }};" target="_blank" href="{{ invoice }}" class="btn btn-primary"><i class="fa fa-print"></i> {{ button_invoice_print }}</a></div>
	{% if printinvoice=='1' %}
	  
	{% endif %}
		{{ text_message }}
	  
	   
	   
	  <!--Order Code-->
	  {% if orderdetail=='1' %}
	  <table class="table table-bordered table-hover">
        <thead>
          <tr style="background:{{ titlebgcolor }}; color:{{ titlecolor }};">
            <td class="text-left" colspan="2">{{ text_order_detail }}</td>
		 
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="text-left" style="width: 50%;">
			  {% if orderinvoice=='1' %}
              <b>{{ text_order_id }}</b> {{ order_id }}<br />
			   {% endif %}
              <b>{{ text_date_added }}</b> {{ date_added }}<br />
			  {% if payment_method %}
              <b>{{ text_payment_method }}</b> {{ payment_method }}<br />
			  {% endif %}
              {% if shipping_method %}
              <b>{{ text_shipping_method }}</b> {{ shipping_method }}
              {% endif %}</td>
			  <td class="text-left" style="width: 50%;">
			  <b>{{ text_email }} </b>{{ email }}<br />
			  <b>{{ text_telephone }} </b>{{ telephone }}<br />
			  <b>{{ text_orderstatus }} </b>{{ orderstatus }}<br />
			  </td>
          </tr>
        </tbody>
      </table>
	  {% endif %}
	   
      <table class="table table-bordered table-hover">
        <thead>
          <tr style="background:{{ titlebgcolor }}; color:{{ titlecolor }};">
			{% if paymentaddress=='1' %}
            <td class="text-left" style="width: 50%; vertical-align: top;">{{ text_payment_address }}</td>
			{% endif %}
			{% if shippingaddress=='1' %}
            {% if shipping_address %}
            <td class="text-left" style="width: 50%; vertical-align: top;">{{ text_shipping_address }}</td>
            {% endif %}  
            {% endif %}			
          </tr>
        </thead>
        <tbody>
          <tr>
			{% if paymentaddress=='1' %}
            <td class="text-left">{{ payment_address }}</td>
			 {% endif %}
			{% if shippingaddress=='1' %}
            {% if shipping_address %}
            <td class="text-left">{{ shipping_address }}</td>
			 {% endif %}
			 {% endif %}
          </tr>
        </tbody>
      </table>
	  
      <div class="table-responsive">
        <table class="table table-bordered">
      <thead>
        <tr style="background:{{ titlebgcolor }}; border:solid 1px {{ titlebgcolor }}; color:{{ titlecolor }};">
		{% set r = 0 %} {% if showimage=='1' %} {% set r = r + 1 %}
           <td class="text-center">{{ column_image }}</td>
		  {% endif %}
			{% if productname=='1' %} {% set r = r + 1 %}
            <td class="text-left">{{ column_name }}</td>
			{% endif %}
			{% if productmodel=='1' %} {% set r = r + 1 %}
			<td><b>{{ column_model }}</b></td>
			{% endif %}
			{% if productsku=='1' %} {% set r = r + 1 %}
			<td><b>{{ column_sku }}</b></td>
			 {% endif %}
			 {% if productqty=='1' %} {% set r = r + 1 %}
			<td class="text-right"><b>{{ column_quantity }}</b></td>
			 {% endif %}
			 {% if productunitprice=='1' %} {% set r = r + 1 %}
			<td class="text-right"><b>{{ column_price }}</b></td>
			 {% endif %}
			 {% if producttotal=='1' %} {% set r = r + 1 %}
			<td class="text-right"><b>{{ column_total }}</b></td>
			 {% endif %}
			   {% if facebookshare=='1' %}	 {% set r = r + 1 %}
			 <td class="text-center"><b>{{ text_share }}</b></td>
			  {% endif %}
        </tr>
      </thead>
      <tbody> 
		{% if order.products %}
        {% for product in order.products %}
        <tr>
		{% if showimage=='1' %}
			<td class="text-center">
			{% if product.image %}
			<img src="{{ product.image }}" alt="{{ product.name }}" class="img-thumbnail" />
			{% else %}
			<span class="img-thumbnail list"><i class="fa fa-camera fa-2x"></i></span>
		   {% endif %}</td>
		{% endif %}
		{% if productname=='1' %}
          <td>{{ product.name }}
            {% for option in product.option %}
            <br />
            &nbsp;<small> - {{ option.name }}: {{ option.value }}</small>
            {% endfor %}</td>
		{% endif %}
			{% if productmodel=='1' %}
          <td>{{ product.model }}</td>
		    {% endif %}
			  {% if productsku=='1' %}
		    {% if product.sku %}
          <td>{{ product.sku }}</td>
		  {% else %}
		  <td></td>
		  {% endif %}
			  {% endif %}
		  {% if productqty=='1' %}
          <td class="text-right">{{ product.quantity }}</td>
		  {% endif %}
		  {% if productunitprice=='1' %}
          <td class="text-right">{{ product.price }}</td>
		   {% endif %}
		    {% if producttotal=='1' %}
          <td class="text-right">{{ product.total }}</td>
		  {% endif %}
		  <td class="text-center" colspan="{{ r }}">
		  {% if facebookshare=='1' %}	
			<a href="http://www.facebook.com/sharer/sharer.php?u={{ product.href }}" target="_blank" data-toggle="tooltip" title="Share"><img style="display:inline-block;" src="catalog/view/theme/default/image/fb_new.png" class="img-responsive" alt="fb" title="fb" /></a>
			{% endif %}
			{% if twittershare=='1' %}
			<a href="http://twitter.com/share?text={{ product.name }}&url={{ product.href }}" target="_blank" data-toggle="tooltip" title="Share"><img style="display:inline-block;" src="catalog/view/theme/default/image/tw_new.png" class="img-responsive" alt="tw" title="tw" /></a>
			{% endif %}
			{% if googleshare=='1' %}
			<a href="https://plus.google.com/share?url={{ product.href }}" target="_blank" data-toggle="tooltip" title="Share"> <img style="display:inline-block;" src="catalog/view/theme/default/image/g+_new.png" class="img-responsive" alt="g+" title="g+" /></a>
			{% endif %}
		{% endfor %}
		</td>
        </tr>
		 {% endif %}
		{% if vouchers %}
        {% for voucher in vouchers %}
        <tr style="background:#2197c4; color:#fff;">
          <td>{{ voucher.description }}</td>
          <td></td>
          <td class="text-right">1</td>
          <td class="text-right">{{ voucher.amount }}</td>
          <td class="text-right">{{ voucher.amount }}</td>
        </tr>
		{% endfor %}
		 {% endif %}
		{% if totals %}
        {% for total in totals %}
        <tr>
			  <td colspan="{{ r-2 }}"></td>
			  <td class="text-right"><b>{{ total.title }}</b></td>
              <td class="text-right">{{ total.text }}</td>
            </tr>
			{% endfor %}
        {% endif %}
      </tbody>
    </table>
      </div>
	  <!--Order Code-->
	  {% if tracking is not empty  %}
      <div class="buttons col-sm-12 continuebtn">
		<div class="pull-right"><a style="background:{{ titlebgcolor }}; border:solid 1px {{ titlebgcolor }}; color:{{ titlecolor }};" href="{{ continue }}" class="btn btn-primary"><i class="fa fa-home"></i> {{ button_continue }}</a></div>
		{% endif %}
      </div>
	  
	<!--Products-->
	
	<h1 class="text-center">{{ text_relatedproduct }}</h1>
	<hr/>
	<div class="row">
	
	  {% for product in relproducts %}
	  <div class="product-layout col-lg-3 col-md-3 col-sm-6 col-xs-12">
		<div class="product-thumb transition">
		  <div class="image"><a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-responsive" /></a></div>
		  <div class="caption">
			<h4><a href="{{ product.href }}">{{ product.name }}</a></h4>
			<p>{{ product.description }}</p>
			{% if product.rating %}
			<div class="rating">
			  {% for i in 1..5 %}
			  {% if product.rating < i %}
			  <span class="fa fa-stack"><i class="fa fa-star-o fa-stack-2x"></i></span>
			 {% else %}
			  <span class="fa fa-stack"><i class="fa fa-star fa-stack-2x"></i><i class="fa fa-star-o fa-stack-2x"></i></span>
			 {% endif %}
                {% endfor %}
			</div>
			{% endif %}
			{% if product.price %}
              <p class="price"> {% if not product.special %}
                {{ product.price }}
                {% else %}
			  <span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span> {% endif %}
			  {% if product.tax %} <span class="price-tax">{{ text_tax }} {{ product.tax }}</span> {% endif %} </p>
              {% endif %}
		  </div>
		  <div class="button-group">
			<button type="button" onclick="cart.add('{{ product.product_id }}');"><i class="fa fa-shopping-cart"></i> <span class="hidden-xs hidden-sm hidden-md">{{ button_cart }}</span></button>
			<button type="button" data-toggle="tooltip" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa fa-heart"></i></button>
			<button type="button" data-toggle="tooltip" title="{{ button_compare }}" onclick="compare.add('{{ product.product_id }}');"><i class="fa fa-exchange"></i></button>
		  </div>
		</div>
	  </div>
	  {% endfor %}
	</div>
	<!--Products-->
    {{ content_bottom }}</div>
	{{ column_right }}</div>
	</div>
	<style>
	.continuebtn{padding-right:0px;padding-bottom:10px}
	.socilashare{padding:0px 3px 20px  0px;border-bottom:solid 1px #ccc; margin-bottom:20px}
		{{ customcss }}
	</style>
	{{ footer }}
