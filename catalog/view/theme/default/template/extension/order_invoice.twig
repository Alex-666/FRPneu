<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
<meta charset="UTF-8" />
<title>{{ title }}</title>
<base href="{{ base }}" />
<link href="catalog/view/javascript/bootstrap/css/bootstrap.css" rel="stylesheet" media="all" />
<script src="catalog/view/javascript/jquery/jquery-2.1.1.min.js" type="text/javascript"></script>
<script src="catalog/view/javascript/bootstrap/js/bootstrap.min.js" type="text/javascript"></script>
<link href="catalog/view/javascript/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css" />
<link href="catalog/view/theme/default/stylesheet/stylesheet.css" rel="stylesheet"></head>
<body>
<div class="container">
  {% for order in orders %}
	<div style="page-break-after: always;">
		<h1>{{ text_invoice }} #{{ order.order_id }}</h1>
		{% if orderdetail=='1' %}
			<table class="table table-bordered">
			  <thead>
				<tr style="background:{{ titlebgcolor }}; border:solid 1px {{ titlebgcolor }}; color:{{ titlecolor }};">
				  <td colspan="2">{{ text_order_detail }}</td>
				</tr>
			  </thead>
			  <tbody>
				<tr>
				  <td style="width: 50%;"><address>
					<strong>{{ order.store_name }}</strong><br />
					{{ order.store_address }}
					</address>
					<b>{{ text_telephone }}</b> {{ order.store_telephone }}<br />
					{% if order.store_fax %}
					<b>{{ text_fax }}</b> {{ order.store_fax }}<br />
					{% endif %}
					<b>{{ text_email }}</b> {{ order.store_email }}<br />
					<b>{{ text_website }}</b> <a href="{{ order.store_url }}">{{ order.store_url }}</a></td>
				  <td style="width: 50%;"><b>{{ text_date_added }}</b> {{ order.date_added }}<br />
					{% if order.invoice_no %}
					<b>{{ text_invoice_no }}</b> {{ order.invoice_no }}<br />
					{% endif %}
					<b>{{ text_order_id }}</b> {{ order.order_id }}<br />
					<b>{{ text_payment_method }}</b> {{ order.payment_method }}<br />
					{% if order.shipping_method %}
					<b>{{ text_shipping_method }}</b> {{ order.shipping_method }}<br />
					{% endif %}</td>
				</tr>
			  </tbody>
			</table>
		{% endif %}
			<table class="table table-bordered">
			  <thead>
				<tr style="background:{{ titlebgcolor }}; border:solid 1px {{ titlebgcolor }}; color:{{ titlecolor }};">
				{% if paymentaddress=='1' %}
				  <td style="width: 50%;"><b>{{ text_payment_address }}</b></td>
				  {% endif %}
					{% if shippingaddress=='1' %}
				  <td style="width: 50%;"><b>{{ text_shipping_address }}</b></td>
				 {% endif %}
				</tr>
			  </thead>
			  <tbody>
				<tr>
				{% if paymentaddress=='1' %}
				  <td><address>
					{{ order.payment_address }}
					</address></td>
				{% endif %}
				{% if shippingaddress=='1' %}
				  <td><address>
					{{ order.shipping_address }}
					</address></td>
				{% endif %}
				</tr>
			  </tbody>
			</table>
			<table class="table table-bordered">
			  <thead>
				<tr style="background:{{ titlebgcolor }}; border:solid 1px {{ titlebgcolor }}; color:{{ titlecolor }};">
				{% set r = 0 %} {% if showimage=='1' %} {% set r = r + 1 %}
				   <td class="text-center">{{ column_image }}</td>
				  {% endif %}
					{% if productname=='1' %} {% set r = r + 1 %}
					<td class="text-left">{{ column_name }}</td>
					{% endif %}
					{% if productmodel=='1' %} {% set r = r + 1 %}
					<td><b>{{ column_model }}</b></td>
					{% endif %}
					{% if productsku=='1' %} {% set r = r + 1 %}
					<td><b>{{ column_sku }}</b></td>
					 {% endif %}
					 {% if productqty=='1' %} {% set r = r + 1 %}
					<td class="text-right"><b>{{ column_quantity }}</b></td>
					 {% endif %}
					 {% if productunitprice=='1' %} {% set r = r + 1 %}
					<td class="text-right"><b>{{ column_price }}</b></td>
					 {% endif %}
					 {% if producttotal=='1' %} {% set r = r + 1 %}
					<td class="text-right"><b>{{ column_total }}</b></td>
					 {% endif %}
					  {% if text_share=='1' %} {% set r = r + 1 %}
					 <td class="text-center"><b>{{ text_share }}</b></td>
					  {% endif %}
				</tr>
			  </thead>
			  <tbody>
				{% for product in order.product %}
					<tr>
						{% if showimage=='1' %}
							<td class="text-center">
								{% if product.image %}
								<img src="{{ product.image }}" alt="{{ product.name }}" class="img-thumbnail" />
								{% else %}
								<span class="img-thumbnail list"><i class="fa fa-camera fa-2x"></i></span>
							   {% endif %}
						   </td>
						{% endif %}
						{% if productname=='1' %}
						  <td>{{ product.name }}
							{% for option in product.option %}
							<br />
							&nbsp;<small> - {{ option.name }}: {{ option.value }}</small>
							{% endfor %}
						  </td>
						{% endif %}
						{% if productmodel=='1' %}
						  <td>{{ product.model }}</td>
						{% endif %}
						{% if productsku=='1' %}
							{% if product.sku %}
								<td>{{ product.sku }}</td>
							{% else %}
								<td></td>
							{% endif %}
						{% endif %}
						{% if productqty=='1' %}
							<td class="text-right">{{ product.quantity }}</td>
						{% endif %}
						{% if productunitprice=='1' %}
							<td class="text-right">{{ product.price }}</td>
						{% endif %}
						{% if producttotal=='1' %}
						  <td class="text-right">{{ product.total }}</td>
						{% endif %}
					</tr>
				{% endfor %}
				
				
				{% for voucher in order.voucher %}
				<tr style="background:#2197c4; color:#fff;">
				  <td>{{ voucher.description }}</td>
				  <td></td>
				  <td class="text-right">1</td>
				  <td class="text-right">{{ voucher.amount }}</td>
				  <td class="text-right">{{ voucher.amount }}</td>
				</tr>
				{% endfor %}
				{% for total in order.total %}
				<tr>
					  <td colspan="{{ r-2 }}"></td>
					  <td class="text-right"><b>{{ total.title }}</b></td>
					  <td class="text-right">{{ total.text }}</td>
				</tr>
				{% endfor %}
			  </tbody>
			</table>
			{% if order.comment %}
			<table class="table table-bordered">
			  <thead>
				<tr>
				   <td><b>{{ text_comment }}</b></td>
				</tr>
			  </thead>
			  <tbody>
				<tr>
				  <td>{{ order.comment }}</td>
				</tr>
			  </tbody>
			</table>
			{% endif %}
	</div>
  {% endfor %}
</div>
</body>
</html>
